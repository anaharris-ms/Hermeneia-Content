            {
              "form": "ὄπισθεν",
              "lemma": null,
              "location": "327b",
              "context": "οὗτος, ἔφη, ὄπισθεν προσέρχεται"
            }
          ],
          "observation": "ὄπισθεν appears twice: once for the slave grabbing Socrates' cloak from behind, once for Polemarchus approaching from behind."
        },
        {
          "id": "republic-chapter-01-section-01:s015",
          "scan_targets": [],
          "features": [
            "other_textual_pattern"
