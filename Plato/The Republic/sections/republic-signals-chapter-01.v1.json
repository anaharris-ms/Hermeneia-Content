              "lemma": "μεταστρέφω",
              "location": "327b",
              "context": "καὶ ἐγὼ μετεστράφην τε καὶ ἠρόμην ὅπου αὐτὸς εἴη"
            }
          ],
          "observation": "Socrates turns around (μετεστράφην)—a physical reversal of direction at the moment of being stopped."
        },
        {
          "id": "republic-chapter-01-section-01:s016",
          "scan_targets": [],
          "features": [
            "semantic_cluster"
          ],
          "elements": [
            {
              "form": "παννυχίδα",
              "lemma": "παννυχίς",
              "location": "328a",
              "context": "πρός γε παννυχίδα ποιήσουσιν"
            },
            {
              "form": "παννυχίδα",
              "lemma": "παννυχίς",
              "location": "328a",
              "context": "τὴν παννυχίδα θεασόμεθα"
            },
            {
              "form": "μετὰ τὸ δεῖπνον",
              "lemma": null,
              "location": "328a",
              "context": "ἐξαναστησόμεθα γὰρ μετὰ τὸ δεῖπνον"
            },
